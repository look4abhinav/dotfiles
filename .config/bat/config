# This is default config for bat.

# Set the theme to "Catppuccin Mocha"
--theme="Catppuccin Mocha"

# Show line numbers, git modifications and file header (but no grid)
--style="numbers,changes,header"

# Use italic text on the terminal (not supported on all terminals)
--italic-text=always

# Pager keeps colors and quits when output fits on one screen
--pager="less -FR"

# Treat .ignore files like .gitignore for highlighting
--map-syntax .ignore:gitignore