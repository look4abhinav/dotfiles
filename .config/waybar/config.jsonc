{
  "layer": "top",
  "modules-left": ["hyprland/workspaces", "group/system-stats"],
  "modules-center": ["clock"],
  "modules-right": [
    "hyprland/submap",
    "group/volume",
    "group/brightness",
    "battery",
    "bluetooth",
    "network",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "󰈹",
      "2": "",
      "3": "󰨞",
      "4": "󰉋",
      "5": "󰏑",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 35,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec ghostty --title=bluetooth -e bluetui",
  },
  "cpu": {
    "interval": 1,
    "states": {
      "warning": 70,
      "critical": 90,
    },
    "format": " {usage}%",
    "tooltip-format": " {usage}%  (load {load})",
    "max-length": 10,
    "on-click": "exec ghostty --title=btop -e btop",
  },
  "memory": {
    "interval": 2,
    "states": {
      "warning": 70,
      "critical": 90,
    },
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G used\nSwap: {swapUsed:0.1f}G/{swapTotal:0.1f}G ({swapPercentage}%)",
    "on-click": "exec ghostty --title=htop -e htop",
  },
  "network": {
    "format": "", // An empty format will hide the module.
    "format-wifi": "󰤨",
    "format-ethernet": "󰈁",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "󰖪",
    "max-length": 50,
    "on-click": "~/.config/waybar/custom_modules/wifi-menu.sh",
  },
  "clock": {
    "format": "{:%A | %d %b %Y | %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color='#75f1fa'><b>{}</b></span>",
      },
    },
    "on-click": "exec chromium --app=https://calendar.google.com",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""],
    },
    "scroll-step": 5,
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "pavucontrol",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "group/volume": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃠"],
    "on-click": "brightnessctl set +10%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set -5%",
  },
  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "group/brightness": {
    "orientation": "horizontal",
    "modules": ["backlight", "backlight/slider"],
  },
  "group/system-stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory"],
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout -b 3 -T 300 -B 300 -L 150 -R 150",
  },
}
