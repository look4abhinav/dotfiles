{
  "layer": "top",
  "modules-left": ["hyprland/workspaces", "group/system-stats"],
  "modules-center": ["clock"],
  "modules-right": [
    "hyprland/submap",
    "group/volume",
    "group/brightness",
    "battery",
    "bluetooth",
    "network",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "󰈹",
      "2": "",
      "3": "󰨞",
      "4": "󰉋",
      "5": "󰏑",
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5],
    },
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 35,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰂁", "󰂉"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
    "tooltip-format": "Battery: <span color='#75f1fa'>{capacity}%</span>  {timeTo}",
    "tooltip-format-charging": "Battery: <span color='#42ff9f'>{capacity}%</span>  Charging  {timeTo}",
    "tooltip-format-charging-warning": "Battery: <span color='#f0a040'>{capacity}%</span>  Charging  {timeTo}",
    "tooltip-format-charging-critical": "Battery: <span color='#e35149'>{capacity}%</span>  Charging  {timeTo}",
    "tooltip-format-discharging": "Battery: <span color='#42ff9f'>{capacity}%</span>  Discharging  {timeTo}",
    "tooltip-format-discharging-warning": "Battery: <span color='#f0a040'>{capacity}%</span>  Discharging  {timeTo}",
    "tooltip-format-discharging-critical": "Battery: <span color='#e35149'>{capacity}%</span>  Discharging  {timeTo}",
    "tooltip-format-full": "Battery: <span color='#42ff9f'>{capacity}%</span>  Full",
    "tooltip-format-plugged": "Battery: <span color='#42ff9f'>{capacity}%</span>  Plugged  {timeTo}",
    "tooltip-format-not-charging": "Battery: <span color='#75f1fa'>{capacity}%</span>  Not Charging  {timeTo}",
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂯",
    "tooltip-format": "Bluetooth: <span color='#75f1fa'>{status}</span>",
    "tooltip-format-disabled": "Bluetooth: <span color='#e35149'>Disabled</span>",
    "tooltip-format-off": "Bluetooth: <span color='#e35149'>Off</span>",
    "tooltip-format-on": "Bluetooth: <span color='#f0a040'>On</span>",
    "tooltip-format-connected": "Bluetooth: <span color='#42ff9f'>Connected</span>\n{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-no-controller": "Bluetooth: <span color='#e35149'>No Controller</span>",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "exec ghostty --title=bluetooth -e bluetui",
  },
  "custom/cpu#cpu": {
    "interval": 1,
    "return-type": "json",
    "exec": "~/.config/waybar/custom_modules/system-stats.py cpu",
    "format": " {text}",
    "escape": false,
    "max-length": 10,
    "on-click": "exec ghostty --title=btop -e btop",
  },
  "custom/memory#memory": {
    "interval": 2,
    "return-type": "json",
    "exec": "~/.config/waybar/custom_modules/system-stats.py memory",
    "format": " {text}",
    "escape": false,
    "on-click": "exec ghostty --title=htop -e htop",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉",
    },
    "tooltip-format-activated": "<b>Awake: <span color='#42ff9f'>Active</span></b>",
    "tooltip-format-deactivated": "<b>Awake: <span color='#75f1fa'>Inactive</span></b>",
    "start-activated": false,
  },
  "network": {
    "format": "", // An empty format will hide the module.
    "format-wifi": "󰤨",
    "format-ethernet": "󰈁",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid}  <span color='#42ff9f'>Connected</span>  Signal: <span color='#75f1fa'>{signalStrength}%</span>",
    "tooltip-format-ethernet": "{ifname}  <span color='#42ff9f'>Connected</span>",
    "tooltip-format-linked": "{ifname}  <span color='#f0a040'>Linked</span>",
    "tooltip-format-disconnected": "<span color='#e35149'>Disconnected</span>",
    "tooltip-format-disabled": "<span color='#e35149'>Wi-Fi Disabled</span>",
    "max-length": 50,
    "on-click": "~/.config/waybar/custom_modules/wifi-menu.sh",
  },
  "clock": {
    "format": "{:%A | %d %b %Y | %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "today": "<span color='#75f1fa'><b>{}</b></span>",
      },
    },
    "on-click": "xdg-open https://calendar.google.com",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", ""],
    },
    "tooltip-format": "Volume: <span color='#75f1fa'>{volume}%</span>  {desc}",
    "scroll-step": 5,
    "ignored-sinks": ["Easy Effects Sink"],
    "on-click": "pavucontrol",
  },
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "group/volume": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "pulseaudio/slider"],
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃝", "󰃠"],
    "on-click": "brightnessctl set +10%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set -5%",
  },
  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "group/brightness": {
    "orientation": "horizontal",
    "modules": ["backlight", "backlight/slider"],
  },
  "group/system-stats": {
    "orientation": "horizontal",
    "modules": ["custom/cpu#cpu", "custom/memory#memory", "idle_inhibitor"],
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout -b 3 -T 300 -B 300 -L 150 -R 150",
  },
}
