# Secrets for ~/.config/hypr/scripts/ voice tools.
# Copy to .env (gitignored) and fill in real values: cp .env.example .env

# OpenAI-compatible gateway (Bifrost). All voice requests go through it.
# Get the key from your Bifrost dashboard.
OPENAI_API_KEY=sk-bf_replace_me
OPENAI_BASE_URL=https://llm.abhinav.cv/v1

# Optional model overrides (defaults shown).
# STT_MODEL=whisper-large-v3
# LLM_MODEL=qwen/qwen3.8-27b
