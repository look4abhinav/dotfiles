# ── OS junk ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Editor / IDE ──────────────────────────────────────────
*.sublime-workspace
*.sublime-project
.idea/
.vscode/
*.code-workspace

# ── NeoVim ────────────────────────────────────────────────
**/nvim/plugin/packer_compiled.lua
**/nvim/spell/*.add
**/nvim/lazy-lock.json
*.spl

# ── Shell history / zsh ──────────────────────────────────
.zsh_history
.zhistory
.zcompdump*
.lesshst

# ── Cache & temp ──────────────────────────────────────────
cache/
*.cache
__pycache__/
*.pyc
*.pyo

# ── Compiled / generated ──────────────────────────────────
*.o
*.so
*.dylib
*.bin

# ── Secrets & tokens ──────────────────────────────────────
.env
.env.*
*.secret
*.token
credentials
secrets/

# ── Node / Python / language runtimes ─────────────────────
node_modules/
.pnpm-store/
.venv/
venv/
env/

# ── Waybar compiled/logs ──────────────────────────────────
**/waybar/waybar.log

# ── herdr runtime state (logs, session.json, plugins.lock) ─
# herdr keeps runtime artifacts next to config.toml; track only the config
**/herdr/*
!**/herdr/config.toml

# ── GNU Stow ──────────────────────────────────────────────
# If you ever accidentally run stow without --target:
usr/

# ── Misc dotfile artifacts ────────────────────────────────
*.bak
*.orig
*.old
.bak/
